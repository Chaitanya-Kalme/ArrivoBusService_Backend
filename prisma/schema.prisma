generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(uuid()) @db.Uuid
  userName                String
  email                   String
  password                String
  mobileNo                String
  // avatar                  String          // This is the cloudinary url string
  isVerified              Boolean   @default(false)
  verificationCode        String?
  verificationCodeExpiry  DateTime?
  resetPasswordCode       String?
  resetPasswordCodeExpiry DateTime?
  refreshToken            String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  bookings                Booking[]
}

model Driver {
  id           String   @id @default(uuid()) @db.Uuid
  userName     String
  email        String
  password     String
  mobileNo     String
  refreshToken String?
  trips        Bus[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model busStop {
  id               Int        @id @default(autoincrement())
  busStopName      String
  ticketPrice      Float
  distance         Float
  busDetailsId     String     @db.Uuid
  arrivalTime      String
  bus              busDetails @relation(fields: [busDetailsId], references: [id], onDelete: Cascade)
  boardingTrips    Booking[]  @relation("BoardingStation")
  destinationTrips Booking[]  @relation("DestinationStation")
}

model busDetails {
  id         String    @id @default(uuid()) @db.Uuid
  busName    String
  busNumber  String
  stops      busStop[]
  rating     Float     @default(0.0)
  buses      Bus[]
  totalSeats Int
}

enum Issues {
  Perfect
  breakdown
  accident
  other
}

model Bus {
  id                String     @id @default(uuid()) @db.Uuid
  busDetailsId      String     @db.Uuid
  busDetails        busDetails @relation(fields: [busDetailsId], references: [id])
  seatMatrix        Boolean[]  @default([])
  dateAndTime       DateTime
  driverId          String     @db.Uuid
  driver            Driver     @relation(fields: [driverId], references: [id])
  // lat and lng are stored for location.
  lat               Float?
  lng               Float?
  passengersBooking Booking[]
  issue             Issues     @default(Perfect)
  issudeDescription String?
}

enum PaymentStatus {
  Completed
  Pending
  Failed
}


enum BookingStatus {
  CONFIRMED 
  PENDING 
  FAILED 
  EXPIRED
  CANCELLED
}

enum Gender {
  Male
  Female
  Other
}

model Passenger {
  id            String  @id @default(uuid()) @db.Uuid
  passengerName String
  age           Int
  gender        Gender
  bookingId     String  @db.Uuid
  booking       Booking @relation(fields: [bookingId], references: [id])
}

model Booking {
  id                     String        @id @default(uuid()) @db.Uuid
  busId                  String        @db.Uuid
  bus                    Bus           @relation(fields: [busId], references: [id], onDelete: Cascade)
  userBookingId          String        @db.Uuid
  bookingUser            User          @relation(fields: [userBookingId], references: [id], onDelete: Cascade)
  paymentStatus          PaymentStatus @default(Pending)
  paymentId              String?       @db.Uuid
  razorpayId             String?
  PassengersList         Passenger[]
  boardingStationId      Int
  boardingStation        busStop       @relation("BoardingStation", fields: [boardingStationId], references: [id], onDelete: Cascade)
  destinationStopId      Int
  destinationStop        busStop       @relation("DestinationStation", fields: [destinationStopId], references: [id], onDelete: Cascade)
  amountPaid             Float
  emailId                String
  mobileNumber           String
  emergencyContactNumber String?
  bookedSeatNumber       Int[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  status                 BookingStatus  @default(PENDING)
}
